sourceDir = "{{ .chezmoi.homeDir }}/dev/dotfiles"

[data]
    name = "{{ promptStringOnce . "name" "Git user name" }}"
    email = "{{ promptStringOnce . "email" "Git personal email (default for all repos)" }}"
    work_email = "{{ promptStringOnce . "work_email" "Git work email (for ~/work/ repos)" }}"
    editor = "{{ promptStringOnce . "editor" "Preferred editor (cursor/code/vim)" }}"
{{- if eq .chezmoi.os "linux" }}
{{-   if (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}
    wsl_memory = "{{ promptStringOnce . "wsl_memory" "WSL memory limit, e.g. 8GB" }}"
    restart_wsl_path = "{{ promptStringOnce . "restart_wsl_path" "RestartWSL scripts path, relative to Windows home or full path (e.g. Desktop/RestartWSL)" }}"
{{-   end }}
{{- end }}
