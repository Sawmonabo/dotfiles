# ~/.bashrc: executed by bash(1) for non-login shells.

# If not running interactively, don't do anything
case $- in
    *i*) ;;
      *) return;;
esac

# --- History ---
HISTCONTROL=ignoreboth
shopt -s histappend
HISTSIZE=1000
HISTFILESIZE=2000

# --- Shell options ---
shopt -s checkwinsize
#shopt -s globstar

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "${debian_chroot:-}" ] && [ -r /etc/debian_chroot ]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# --- Color support ---
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls -lha --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# --- Aliases ---
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias cat='bat --paging=never'

alias alert='notify-send --urgency=low -i "$([ $? = 0 ] && echo terminal || echo error)" "$(history|tail -n1|sed -e '\''s/^\s*[0-9]\+\s*//;s/[;&|]\s*alert$//'\'')"'

# Source local aliases if they exist (not managed by chezmoi)
if [ -f ~/.bash_aliases ]; then
    . ~/.bash_aliases
fi

# --- Completion ---
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    elif [ -f /etc/bash_completion ]; then
        . /etc/bash_completion
    fi
fi

# --- PATH ---
export PATH="$HOME/.local/bin:$PATH"

# Go
export PATH="/usr/local/go/bin:$HOME/go/bin:$PATH"

# Cargo (Rust)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# nvm (Node.js)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# --- Oh My Posh prompt ---
eval "$(oh-my-posh init bash --config ~/.config/oh-my-posh/catppuccin_mocha.omp.json)"

# --- Editor ---
export EDITOR="{{ .editor }} --wait"

# --- Smart IDE launcher ---
# Detects current IDE and routes `code` accordingly.
# If running inside Cursor's terminal, `code <path>` opens in Cursor instead of VS Code.
code() {
    local ide_launcher="code"
    local last_arg
    local routed_target
    local target_path
    local -a prefix_args

    if [[ -n "$VSCODE_GIT_ASKPASS_NODE" && "$VSCODE_GIT_ASKPASS_NODE" == *".cursor-server"* ]]; then
        ide_launcher="cursor"
    fi

    if [[ -n "$CODE_WORKSPACE_ROUTER_DISABLE" ]]; then
        command "$ide_launcher" "$@"
        return
    fi

    if (( $# >= 1 )); then
        last_arg="${@: -1}"
        target_path="$(realpath -m "$last_arg" 2>/dev/null || printf '%s' "$last_arg")"

        case "$target_path" in
            /home/sabossedgh/repos)
                routed_target="/home/sabossedgh/workspaces/repos.code-workspace"
                ;;
            /home/sabossedgh/dev)
                routed_target="/home/sabossedgh/workspaces/dev.code-workspace"
                ;;
        esac

        if [[ -n "$routed_target" ]]; then
            if (( $# > 1 )); then
                prefix_args=("${@:1:$#-1}")
                command "$ide_launcher" "${prefix_args[@]}" "$routed_target"
            else
                command "$ide_launcher" "$routed_target"
            fi
            return
        fi
    fi

    command "$ide_launcher" "$@"
}

alias create-spec='source /home/sabossedgh/repos/ai-devtools/.venv/bin/activate && python /home/sabossedgh/repos/ai-devtools/.claude/tmp/sessions/2026-02-10/artifacts/create_spec_only.py'
# WSL: route browser opens to Windows default browser
export BROWSER=wslview

# Added by remote-dev-workstation install
export PATH="$HOME/bin:$PATH"
# `claude` alias is defined in ~/.bash_aliases (sourced above ~line 46) and
# routes through ~/.local/bin/ab-claude with this user's preferred flags.

# promptctl
[ -f /home/sabossedgh/.promptctl/shell/aliases.sh ] && source /home/sabossedgh/.promptctl/shell/aliases.sh

# >>> agent-brain >>>
# managed by tools/install.sh — do not edit between the markers
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
# Plain `claude` is the real binary + host-wide policy flags. Cross-host
# memory sync is explicit via `ab-claude` (see docs/00-design-spec.md §5.2.7
# for the v1→v2 explicit-sync rationale and the staleness warning that
# fires when the user forgets to ab-claude after a machine switch).
alias claude='command claude --verbose --allow-dangerously-skip-permissions'
# <<< agent-brain <<<


# --- Bitwarden CLI (bw): persistent unlock ---
# `bw unlock` unlocks once (master password) and caches the session key in a
# 0600 file that every new shell reads, so bw commands just work afterwards.
# `bw lock` locks the vault and wipes that cache. Everything else is passed to
# the real binary untouched (`command bw ...` bypasses the wrapper entirely).
# Trade-off: while cached, anyone with this user account can read the vault —
# same class as ~/.aws/credentials. `bw lock` when you are done for the day.
export BW_SESSION_FILE="$HOME/.config/Bitwarden CLI/session"
if [ -r "$BW_SESSION_FILE" ]; then
    BW_SESSION="$(cat "$BW_SESSION_FILE")"; export BW_SESSION
fi
bw() {
    case "$1" in
        unlock)
            command -v bw >/dev/null 2>&1 || { echo "bw not installed (https://bitwarden.com/download/?app=cli&platform=linux)"; return 1; }
            case "$(command bw status 2>/dev/null)" in
                *'"status":"unlocked"'*) echo "vault already unlocked"; return 0 ;;
                *'"status":"unauthenticated"'*) command bw login || return 1 ;;
            esac
            local s
            s="$(command bw unlock --raw)" || return 1
            mkdir -p "$(dirname "$BW_SESSION_FILE")"
            (umask 077; printf '%s' "$s" >"$BW_SESSION_FILE")
            BW_SESSION="$s"; export BW_SESSION
            command bw sync >/dev/null 2>&1
            echo "vault unlocked and synced; session cached for new shells (bw lock to end it)"
            ;;
        lock)
            command bw lock >/dev/null 2>&1
            rm -f "$BW_SESSION_FILE"
            unset BW_SESSION
            echo "vault locked; cached session removed"
            ;;
        *) command bw "$@" ;;
    esac
}
