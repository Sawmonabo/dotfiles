        }
    ],
    "theme": "legacyDark",
    "themes": []
}
WTSETTINGS
    python3 - "$WT_SETTINGS_DIR/settings.json" "$WSL_PROFILE_GUID" "$WSL_PROFILE_EXTRA" <<'PY'
import json, sys
path, guid, extra = sys.argv[1:4]
s = open(path, encoding='utf-8').read().replace('__WSL_PROFILE_GUID__', guid).replace('__WSL_PROFILE_EXTRA__', extra)
json.loads(s)  # fail loudly rather than hand WT a broken file
open(path, 'w', encoding='utf-8').write(s)
PY
    echo "    Windows Terminal settings written."
else
    echo "==> Windows Terminal not found, skipping settings."
fi

# --- PowerShell profile ---
PS_PROFILE_DIR="$WIN_HOME/Documents/WindowsPowerShell"
echo "==> Writing PowerShell profile..."
mkdir -p "$PS_PROFILE_DIR"
if [ -f "$PS_PROFILE_DIR/Microsoft.PowerShell_profile.ps1" ]; then
    cp -a "$PS_PROFILE_DIR/Microsoft.PowerShell_profile.ps1" "$PS_PROFILE_DIR/Microsoft.PowerShell_profile.ps1.before-dotfiles-$(date +%Y%m%d-%H%M%S)"
fi
cat > "$PS_PROFILE_DIR/Microsoft.PowerShell_profile.ps1" << 'PSPROFILE'
# Start in the WSL repos directory when it is reachable (WSL may not be running yet)
$wslRepos = "\\wsl.localhost\{{ env "WSL_DISTRO_NAME" }}\home\{{ .chezmoi.username }}\repos"
if (Test-Path -LiteralPath $wslRepos) { Set-Location -LiteralPath $wslRepos }

# Oh My Posh prompt
& "$env:LOCALAPPDATA\Programs\oh-my-posh\bin\oh-my-posh.exe" init pwsh --config "$env:LOCALAPPDATA\Programs\oh-my-posh\themes\catppuccin_mocha.omp.json" | Invoke-Expression
PSPROFILE
echo "    PowerShell profile written."

echo "==> WSL → Windows bootstrap complete."
echo "    NOTE: Restart Windows Terminal to see changes."
