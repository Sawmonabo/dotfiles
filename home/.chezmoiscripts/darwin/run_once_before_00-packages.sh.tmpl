{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# macOS bootstrap: Homebrew, then every formula and cask listed under
# [packages.darwin] in .chezmoidata/packages.toml, then TPM and VS Code
# extensions. Idempotent: brew skips anything already installed.
set -euo pipefail

echo "==> macOS bootstrap starting..."

# --- Homebrew ---
if ! command -v brew &>/dev/null; then
    echo "==> Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
if [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# --- Formulae (strict; idempotent: brew bundle skips what is installed) ---
# brew bundle resolves aliases (postgresql -> postgresql@N), so it does not
# reinstall on every run the way a `brew list <alias>` probe would.
# --no-upgrade: bootstrap installs what is missing, it never upgrades what is there.
brewfile="$(mktemp)"
caskfile="$(mktemp)"
trap 'rm -f "$brewfile" "$caskfile"' EXIT
{
    echo 'tap "jandedobbeleer/oh-my-posh"'
{{- range .packages.darwin.brew }}
    echo 'brew "{{ . }}"'
{{- end }}
} > "$brewfile"
echo "==> Installing formulae from packages.toml..."
brew bundle install --file="$brewfile" --no-upgrade

# --- Casks (best effort) ---
# brew bundle adopts an app that is already in /Applications only when its
# version matches the cask. A hand-installed app at another version makes
# that cask fail, and this script runs before any file deploys, so a cask
# failure must not abort the apply. Report it and carry on.
{
{{- range .packages.darwin.cask }}
    echo 'cask "{{ . }}"'
{{- end }}
} > "$caskfile"
echo "==> Installing casks from packages.toml..."
if ! brew bundle install --file="$caskfile" --no-upgrade; then
    echo "    WARNING: one or more casks did not install (see above)." >&2
    echo "    An app already in /Applications at a different version cannot be adopted." >&2
    echo "    Let the app update itself, or replace it with the cask version, then run:" >&2
    echo "        brew install --cask --adopt <name>      # same version: adopt in place" >&2
    echo "        brew install --cask --force <name>      # replace with the cask version" >&2
fi

{{ if .has_work -}}
# --- Bitwarden CLI (the bw wrapper in .zshrc expects it) ---
# Role-gated, so it stays out of the role-neutral [packages.darwin] lists.
if ! command -v bw &>/dev/null; then
    echo "==> Installing Bitwarden CLI..."
    brew install bitwarden-cli
    echo "    bitwarden-cli installed."
else
    echo "==> Bitwarden CLI already installed, skipping."
fi

{{ end -}}
# --- Oh My Posh config directory ---
mkdir -p "$HOME/.config/oh-my-posh"

# --- TPM (Tmux Plugin Manager) ---
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
    echo "==> Installing TPM..."
    git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi

# --- VS Code extensions ---
if command -v code &>/dev/null; then
    installed=$(code --list-extensions | tr '[:upper:]' '[:lower:]')
    for extension in \
{{- range .packages.vscode_extensions }}
        "{{ . }}" \
{{- end }}
    ; do
        # tr rather than ${extension,,}: macOS ships bash 3.2, which lacks case expansion
        grep -qxF "$(tr '[:upper:]' '[:lower:]' <<<"$extension")" <<<"$installed" || code --install-extension "$extension" --force
    done
else
    echo "    code CLI not on PATH; skipping VS Code extensions."
fi

echo "==> macOS bootstrap complete."
{{ end -}}
