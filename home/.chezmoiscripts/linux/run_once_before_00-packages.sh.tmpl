{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Bootstrap script for Linux/WSL — installs bat, oh-my-posh, JetBrains Mono Nerd Font, tmux, gh
set -euo pipefail

echo "==> Linux/WSL bootstrap starting..."

# --- base toolchain (a fresh WSL image has no C compiler; cargo/uv/node-gyp all need one) ---
if command -v apt-get &>/dev/null && ! command -v cc &>/dev/null; then
    echo "==> Installing build-essential, curl, unzip, git (sudo)..."
    sudo apt-get update -qq && sudo apt-get install -y -qq build-essential curl unzip git ca-certificates
fi

# --- standard directories (Windows Terminal's WSL profile opens in ~/repos) ---
mkdir -p "$HOME/repos" "$HOME/dev"

# --- bat ---
# Prefer the distro package (seconds, no compiler). Debian/Ubuntu ship the
# binary as `batcat`; expose it as `bat` in ~/.local/bin. Fall back to cargo
# only where apt is unavailable.
if ! command -v bat &>/dev/null; then
    if command -v apt-get &>/dev/null; then
        echo "==> Installing bat via apt..."
        sudo apt-get install -y -qq bat
        if ! command -v bat &>/dev/null && command -v batcat &>/dev/null; then
            mkdir -p "$HOME/.local/bin"
            ln -sf "$(command -v batcat)" "$HOME/.local/bin/bat"
        fi
    else
        echo "==> Installing bat via cargo..."
        if ! command -v cargo &>/dev/null; then
            echo "    Installing rustup first..."
            curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
            . "$HOME/.cargo/env"
        fi
        cargo install bat
    fi
    echo "    bat installed."
else
    echo "==> bat already installed, skipping."
fi

# --- oh-my-posh ---
if ! command -v oh-my-posh &>/dev/null; then
    echo "==> Installing oh-my-posh..."
    curl -s https://ohmyposh.dev/install.sh | bash -s -- -d ~/.local/bin
    echo "    oh-my-posh installed."
else
    echo "==> oh-my-posh already installed, skipping."
fi

# --- Oh My Posh themes (downloaded to cache) ---
THEMES_DIR="$HOME/.cache/oh-my-posh/themes"
if [ ! -d "$THEMES_DIR" ] || [ -z "$(ls -A "$THEMES_DIR" 2>/dev/null)" ]; then
    echo "==> Downloading oh-my-posh themes..."
    mkdir -p "$THEMES_DIR"
    THEMES_URL="https://github.com/JanDeDobbeleer/oh-my-posh/releases/latest/download/themes.zip"
    curl -fsSL "$THEMES_URL" -o /tmp/omp-themes.zip
    unzip -o /tmp/omp-themes.zip -d "$THEMES_DIR"
    rm -f /tmp/omp-themes.zip
    chmod u+rw "$THEMES_DIR"/*.omp.*
    echo "    Themes installed to $THEMES_DIR"
else
    echo "==> oh-my-posh themes already present, skipping."
fi

# --- Oh My Posh config directory ---
OMP_CONFIG_DIR="$HOME/.config/oh-my-posh"
mkdir -p "$OMP_CONFIG_DIR"

# --- JetBrains Mono Nerd Font ---
FONT_DIR="$HOME/.local/share/fonts"
if ! fc-list | grep -qi "JetBrainsMono Nerd Font" 2>/dev/null; then
    echo "==> Installing JetBrains Mono Nerd Font..."
    mkdir -p "$FONT_DIR"
    FONT_URL=$(curl -fsSL https://api.github.com/repos/ryanoasis/nerd-fonts/releases/latest \
        | grep -o '"browser_download_url": *"[^"]*JetBrainsMono[^"]*\.zip"' \
        | head -1 \
        | cut -d'"' -f4)
    if [ -n "$FONT_URL" ]; then
        curl -fsSL "$FONT_URL" -o /tmp/jetbrains-mono-nf.zip
        unzip -o /tmp/jetbrains-mono-nf.zip -d "$FONT_DIR"
        rm -f /tmp/jetbrains-mono-nf.zip
        fc-cache -fv
        echo "    JetBrains Mono Nerd Font installed."
    else
        echo "    WARNING: Could not find JetBrains Mono Nerd Font download URL."
    fi
else
    echo "==> JetBrains Mono Nerd Font already installed, skipping."
fi

# --- gh (GitHub CLI) ---
# From GitHub's own package repo, not the distro's: Ubuntu universe lags a
# year+ behind (26.04 ships 2.46 vs upstream 2.9x) and gh auth/extension
# features move fast. Steps follow github.com/cli/cli/blob/trunk/docs/install_linux.md.
# If a distro-packaged gh is already present it is left alone but the repo is
# still added so `apt upgrade` moves it to the upstream build.
if command -v apt-get &>/dev/null; then
    if [ ! -f /etc/apt/sources.list.d/github-cli.list ]; then
        echo "==> Adding GitHub CLI apt repository..."
        sudo mkdir -p -m 755 /etc/apt/keyrings
        curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
            | sudo tee /etc/apt/keyrings/githubcli-archive-keyring.gpg >/dev/null
        sudo chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
            | sudo tee /etc/apt/sources.list.d/github-cli.list >/dev/null
        sudo apt-get update -qq
    fi
    if ! command -v gh &>/dev/null; then
        echo "==> Installing gh via apt (cli.github.com)..."
        sudo apt-get install -y -qq gh
        echo "    gh installed: $(gh --version | head -1)"
    else
        echo "==> gh already installed ($(gh --version | head -1)), skipping."
    fi
elif command -v dnf &>/dev/null; then
    if ! command -v gh &>/dev/null; then
        echo "==> Installing gh via dnf (cli.github.com)..."
        sudo dnf install -y 'dnf-command(config-manager)'
        sudo dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo
        sudo dnf install -y gh --repo gh-cli
        echo "    gh installed."
    else
        echo "==> gh already installed, skipping."
    fi
else
    echo "    WARNING: Could not detect package manager. Install gh manually: https://cli.github.com"
fi

# --- tmux ---
if ! command -v tmux &>/dev/null; then
    echo "==> Installing tmux..."
    if command -v apt-get &>/dev/null; then
        sudo apt-get update && sudo apt-get install -y tmux
    elif command -v dnf &>/dev/null; then
        sudo dnf install -y tmux
    else
        echo "    WARNING: Could not detect package manager. Install tmux manually."
    fi
    echo "    tmux installed."
else
    echo "==> tmux already installed, skipping."
fi

# --- TPM (Tmux Plugin Manager) ---
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
    echo "==> Installing TPM (Tmux Plugin Manager)..."
    git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
    echo "    TPM installed."
else
    echo "==> TPM already installed, skipping."
fi

echo "==> Linux/WSL bootstrap complete."
{{ end -}}
