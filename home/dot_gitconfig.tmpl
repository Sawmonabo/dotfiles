[user]
    name = {{ .name }}
    email = {{ .email }}
[core]
    editor = {{ .editor }} --wait
[init]
    defaultBranch = main
[pull]
    rebase = false

# Directory-based identity overrides
# Repos under ~/dev/ use personal email
[includeIf "gitdir:~/dev/"]
    path = ~/.gitconfig-personal
[alias]
    refresh = !git fetch --all --prune && git pull --all --prune
