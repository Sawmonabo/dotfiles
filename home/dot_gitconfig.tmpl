[user]
    name = {{ .name }}
    email = {{ .email }}
[core]
    editor = {{ .editor }} --wait
[init]
    defaultBranch = main
[pull]
    rebase = false

{{- if eq .machine_role "both" }}

# Directory-based identity overrides (machine_role = both).
# ~/dev/ is personal, ~/repos/ and ~/work/ are work. Single-role machines
# use [user] email everywhere and deploy neither override file.
[includeIf "gitdir:~/dev/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/repos/"]
    path = ~/.gitconfig-work
[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig-work
{{- end }}
[alias]
    refresh = !git fetch --all --prune && git pull --all --prune
{{- if lookPath "gh" }}

# GitHub auth via the gh CLI (gh auth login). Path-independent so the same
# block works on Linux/WSL (apt) and macOS (brew). The empty helper line
# clears any system-level helper first, as `gh auth setup-git` writes it.
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential
{{- end }}
