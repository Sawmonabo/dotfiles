# ~/.zshrc: executed by zsh for interactive shells.

# --- History ---
HISTSIZE=1000
SAVEHIST=2000
HISTFILE=~/.zsh_history
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt APPEND_HISTORY
setopt SHARE_HISTORY

# --- PATH ---
# Homebrew (Apple Silicon)
if [ -d "/opt/homebrew/bin" ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi
# Homebrew (Intel)
if [ -x "/usr/local/bin/brew" ]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

export PATH="$HOME/.local/bin:$PATH"

# Go
export PATH="/usr/local/go/bin:$HOME/go/bin:$PATH"

# Cargo (Rust)
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# nvm (Node.js)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

# PostgreSQL: keg-only, so it needs a PATH entry. The version-free opt link is
# the alias Homebrew maintains for the "postgresql" formula in packages.toml, so
# this follows whichever major version that alias currently installs.
export PATH="/opt/homebrew/opt/postgresql/bin:$PATH"

# --- Completion ---
# Every fpath entry must be in place before compinit runs, or its completions
# are never registered: brew shellenv (above) prepends Homebrew's
# site-functions, and Docker Desktop writes the docker CLI completion to
# ~/.docker/completions. compinit used to run at the top of this file, which
# left docker, gh, brew and chezmoi without completion in a fresh terminal.
# The five lines below are byte-for-byte what Docker Desktop's "Configure shell
# completions -> Automatically" appends to .zshrc. Keeping them identical here
# means Docker Desktop recognises the setup and never appends a second copy,
# while chezmoi stays the owner of the file. The guarded compinit runs once in
# a fresh shell and registers everything in fpath, Homebrew's included.
# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=({{ .chezmoi.homeDir }}/.docker/completions $fpath)
autoload -Uz compinit
(( ${+_comps[docker]} )) || compinit
# End of Docker CLI completions

# uv (Python package and project manager): defines its completion at runtime,
# so it has to come after compinit.
if command -v uv &> /dev/null; then
    eval "$(uv generate-shell-completion zsh)"
fi

# --- Aliases ---
alias ls='ls -lhaG'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias cat='bat --paging=never'
alias grep='grep --color=auto'
claude() { command claude --verbose --allow-dangerously-skip-permissions "$@"; }

# --- Oh My Posh prompt ---
eval "$(oh-my-posh init zsh --config ~/.config/oh-my-posh/catppuccin_mocha.omp.json)"

# --- Editor ---
export EDITOR="{{ .editor }} --wait"

{{- if .has_work }}

{{ includeTemplate "bw-wrapper.sh" . | trim }}
{{- end }}

# --- Local overrides (not managed by chezmoi) ---
# Machine-specific aliases and installer blocks belong here so chezmoi apply
# never removes them.
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
