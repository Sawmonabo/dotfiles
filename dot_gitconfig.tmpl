[user]
    name = {{ .name }}
    email = {{ .email }}
[core]
    editor = {{ .editor }} --wait
[init]
    defaultBranch = main
[pull]
    rebase = false
[alias]
    refresh = !git fetch --all --prune && git pull --all --prune

# Directory-based identity overrides
# Repos under ~/work/ use work email
[includeIf "gitdir:~/work/"]
    path = ~/.gitconfig-work
